/*1.- Configuración global y reset*/
*{
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body{
    font-family: "Verdana", sans-serif;
    color: rgb(24,24,24);
    background-color: rgb(220,225,255);
    overflox-x: hidden;
}

/*2.- Barra de navegación superior*/
.top-nav{
    display: flex;
    justify-content: center;
    gap: 3rem;
    padding: 1.5rem 0;
    margin-bottom: 3rem;
    background: rgba(85,180,225,0.6);
    border-radius: 50px;
    width: 60%;
    margin-left: auto;
    margin-right: auto;
}

/*Variante para alinear el nav a a la derecha en la primera sección si se necesita*/
.top-nav.align-right{
    margin-lef: auto;
    margin-right: 0;
    width: 50%;
}

.nav-link{
    text-decoration: none;
    font-family: "Segoe UI", Tahoma, Geneva, Verdana, Sans-serif;
    font-weight: 600;
    color: rgb(85,85,115);
    font-size: 0.95rem;
    transition: color 0.2s ease;
}

.nav-link:hover, .nav-link.active{
    color: rgb(24,24,24);
    border-bottom: 2px solid rgb(24,24,24);
}

/*3.- Primera sección del Home (cuadro verde (sketch p5)+ columna derecha)*/
.hero-section{
    display: flex;
    width: 100vw;
    height: 100vh; /*Ocupa exactamente la primera pantalla*/
    overFlow: hidden;
}

.sidebar-interactive{
    width: 45vw; /*El cuadro verde de la izquierda*/
    height: 100%;
    background-color: #9acd32; 
}

#p5-container{
    width: 100%;
    height: 100%;
}

.hero-right-content{
    width: 55vw; /*La parte derecha de la primera sección*/
    height: 100%;
    padding: 2rem 4rem;
    overflow-y: auto;
}

/*4.- Secciones posteriores y resto del sitio (flujo centrado normal)*/
.main-container{
    width: 60%;
    max-width: 900px;
    margin: 0 auto;/*Centrado en la pantalla*/
    padding: 4rem 0;
}

.page-section{
    margin-bottom: 6rem;
}

/*5.-Entradas y bloques (articulos y recuadros morados)*/
.post-preview{
    margin-bottom: 5rem;
}

.post-date{
    font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
    font-size: 0.85rem;
    color: rgb(85,85,85);
    display: block;
    margin-bottom: 0.5rem;
}

.post-title, .section-title{
    font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
    font-size: 2.2rem;
    color: #1a1a1a;
    margin-bottom: 1.5rem;
    letter-spacing: -0.5px; 
}

.ai-image-container{
    width: 100%;
    height: 450px;
    background-color: #9b59b6; /* Color morado de tus mockups */
    margin-bottom: 1.5rem;
    border-radius: 4px;
    overflow: hidden;
}

.ai-image-container img{
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.post-excerpt{
    font-size: 1rem;
    line-height: 1.6;
    color: rgb(85,85,85);
}

.about-text{
    font-size: 1.1rem;
    lineHeight: 1.8;
    color: #2c3e50;
}
